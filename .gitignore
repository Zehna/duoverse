# ==============================================================================
# Duoverse Monorepo - Comprehensive .gitignore
# ==============================================================================

# Node / Desktop UI (Tauri, React, Tailwind)
node_modules/
dist/
dist-ssr/
build/
out/
.next/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Rust (Tauri Backend, Injector, Netcode)
target/
**/*.rs.bk
*.pdb

# C / C++ (MinHook, Detours, PE & VFS Modules)
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.dylib
*.exp
*.ilk
*.idb
*.dmp
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
Makefile
*.ninja
.ninja_*

# Tauri Build Artifacts
src-tauri/target/
apps/desktop-ui/src-tauri/target/
# Never commit a copy of the Vite dist/ into the generated Android
# assets folder: Tauri never serves it (no asset-loader domain is
# configured), it only bloats the APK. The frontend is embedded by
# tauri_build from apps/desktop-ui/dist/ instead. See ANDROID_BUILD.md.
apps/desktop-ui/src-tauri/gen/android/app/src/main/assets/

# Game Binaries, Installations & Modded Dumps
# IMPORTANT: Never commit game assets or proprietary executables
*.exe
*.iso
*.pak
*.vpk
*.bundle
*.assets
*.unity3d
*.sav
*.save
*.dmp
crash_dumps/
dumps/
games/
local/

# Python (MCP, Tooling, Test Suites)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs & Temporary Files
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# IDEs & System Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Release Binaries
releases/
*.apk
